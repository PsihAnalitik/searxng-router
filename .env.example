# Скопировать в .env и подставить значения:
#   cp .env.example .env
#   sed -i "s|^SEARXNG_SECRET=.*|SEARXNG_SECRET=$(openssl rand -hex 32)|" .env

# Обязателен. Секрет инстанса, произвольная случайная строка.
SEARXNG_SECRET=

# Адрес на хосте, к которому привязывается порт. Пусто = слушать на всех интерфейсах.
SEARXNG_HOST=127.0.0.1

# Порт (и внутри контейнера, и на хосте).
SEARXNG_PORT=8080

# Тег образа: latest или конкретная версия, напр. 2026.3.25-541c6c3cb
SEARXNG_VERSION=latest

# Не переназначать владельца ./core-config/ на uid контейнера (977) при старте.
# Без этого после первого запуска settings.yml становится недоступен для правки
# обычным пользователем. Контейнер читает конфиг по правам "others" (mode 664/775).
FORCE_OWNERSHIP=false

# Ключ Tavily: https://app.tavily.com — 1000 запросов в месяц на аккаунт.
TAVILY_API_KEY=

# Пароль для эндпоинта /metrics (basic auth, любой непустой).
METRICS_PASSWORD=

# search-router: порт на хосте и бюджеты платных движков.
ROUTER_PORT=8090
LIMIT_TAVILY_MONTH=1000
LIMIT_TAVILY_DAY=50
