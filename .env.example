# docker compose up -d --build works without API keys.
SEARXNG_HOST=127.0.0.1
SEARXNG_PORT=8080
ROUTER_PORT=8090

# Optional: empty means generate once and persist in runtime-config.
SEARXNG_SECRET=
# Optional: empty disables protected SearXNG metrics.
METRICS_PASSWORD=
# Optional personal Google Programmable Search Engine ID.
GOOGLE_CSE_CX=

# Optional global source allowlist for router results, including paid fallback.
# Bare domains separated by commas; subdomains included. Empty = no global filter.
# Example: ALLOWED_DOMAINS=python.org,habr.com
ALLOWED_DOMAINS=

FREE_ENGINES=google,yandex,bing,duckduckgo web
# auto = all non-empty configured provider keys; empty = disable paid fallback.
PAID_ENGINES=auto
TAVILY_API_KEY=
LIMIT_TAVILY_MONTH=1000
LIMIT_TAVILY_DAY=50

# Optional additional key (independent quota). No YAML editing needed.
# TAVILY_API_KEY_2=
# LIMIT_TAVILY_2_MONTH=1000
# LIMIT_TAVILY_2_DAY=50

# Images are pinned in Compose; override only for a deliberate upgrade.
# SEARXNG_VERSION=<tag or tag@sha256:digest>

# Optional paid Yandex Search API v2 (separate from the free yandex engine).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
LIMIT_YANDEX_API_MONTH=1000
LIMIT_YANDEX_API_DAY=50
# YANDEX_API_KEY_2=
# YANDEX_FOLDER_ID_2=   # optional override; otherwise YANDEX_FOLDER_ID is used
# LIMIT_YANDEX_API_2_MONTH=1000
# LIMIT_YANDEX_API_2_DAY=50
